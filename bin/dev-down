#!/usr/bin/env bash
set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
# shellcheck source=lib/clean-path
source "${DIR}/lib/clean-path"
ROOT_DIR="$( cd "${DIR}/.." >/dev/null 2>&1 && pwd )"
MAGENTO_DIR="${1:-$ROOT_DIR/magento-install}"

if [[ ! -d "${MAGENTO_DIR}" || ! -x "${MAGENTO_DIR}/bin/stop" ]]; then
  echo "Magento dev installation with stop script not found in '${MAGENTO_DIR}'."
  echo "Nothing to stop. If this is unexpected, run 'mise run dev:up' first to create the stack."
  exit 0
fi

echo "Stopping dev Magento stack in '${MAGENTO_DIR}'..."
cd "${MAGENTO_DIR}"

# Also stop the services in the test profile (Selenium).
COMPOSE_PROFILES="test" ./bin/stop || true

echo "Dev containers stopped."
