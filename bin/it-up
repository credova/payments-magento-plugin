#!/usr/bin/env bash
set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
# shellcheck source=lib/clean-path
source "${DIR}/lib/clean-path"
ROOT_DIR="$( cd "${DIR}/.." >/dev/null 2>&1 && pwd )"

# Use the same targeted Magento install directory / version / host convention as bin/it-install.
# Default to a 'magento-install' directory at the project root, but allow override via first arg.
MAGENTO_DIR="${1:-$ROOT_DIR/magento-install}"
DEFAULT_MAGENTO_VERSION="2.4.8-p3"
# Allow MAGENTO_VERSION to be overridden via environment variable,
# otherwise fall back to CLI arg 2, then to DEFAULT_MAGENTO_VERSION.
MAGENTO_VERSION="${MAGENTO_VERSION:-${2:-$DEFAULT_MAGENTO_VERSION}}"
MAGENTO_HOST="${3:-magento.test}"
PHPMYADMIN_PORT="${PHPMYADMIN_PORT:-8081}"
DOCKER_MAGENTO_LIB="https://raw.githubusercontent.com/markshust/docker-magento/master/lib"
# One mkcert CA for all installs, so only the first install asks sudo to trust it.
DEV_CA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/psq-magento/mkcert"
CONTAINER_CA_DIR="/root/.local/share/mkcert"

# Start services, retrying once: RabbitMQ can fail the first start on brand-new volumes.
__start_with_retry() {
  "${MAGENTO_DIR}/bin/start" "$@" || { echo "Start failed; retrying once..."; sleep 5; "${MAGENTO_DIR}/bin/start" "$@"; }
}

# Ensure .gitignore contains the install path
__ensure_line_in_file() {
  local FILEPATH="$1"
  local LINE="$2"

  grep -F -- "${LINE}" "${FILEPATH}" >/dev/null 2>&1 || echo -e "\n${LINE}\n" >> "${FILEPATH}"
}

NEEDS_INSTALL=0
if [[ ! -d "${MAGENTO_DIR}" ]]; then
  echo "Magento install directory '${MAGENTO_DIR}' does not exist. Initial Magento setup will be run."
  NEEDS_INSTALL=1
else
  # Directory exists, but we also want to ensure the core src tree is present.
  if [[ ! -x "${MAGENTO_DIR}/bin/magento" || ! -d "${MAGENTO_DIR}/src/app" || ! -f "${MAGENTO_DIR}/src/composer.json" ]]; then
    echo "Magento directory '${MAGENTO_DIR}' exists but does not look initialized (missing core src files)."
    echo "Initial Magento setup will be run and the directory will be recreated."
    NEEDS_INSTALL=1
  fi
fi

if [[ "${NEEDS_INSTALL}" -eq 1 ]]; then
  # The Magento download needs repo.magento.com keys. ~/.composer is mounted into the container.
  if [[ -z "${ADOBE_ACCESS_PUBLIC_KEY:-}" || -z "${ADOBE_ACCESS_PRIVATE_KEY:-}" ]] \
    && ! grep -qs 'repo.magento.com' "${HOME}/.composer/auth.json"; then
    # Hidden prompt keeps the keys out of shell history. They are saved to ~/.composer below.
    echo "Adobe Commerce Marketplace access keys are needed to download Magento (input is hidden)."
    read -rsp "  Public key: " ADOBE_ACCESS_PUBLIC_KEY || true; echo
    read -rsp "  Private key: " ADOBE_ACCESS_PRIVATE_KEY || true; echo
    if [[ -z "${ADOBE_ACCESS_PUBLIC_KEY}" || -z "${ADOBE_ACCESS_PRIVATE_KEY}" ]]; then
      echo "Adobe Commerce Marketplace access keys not found. See LOCAL_DEVELOPMENT.md."
      exit 1
    fi
  fi
  echo
  echo "Magento will be installed in ${MAGENTO_DIR} using markshust/docker-magento onelinesetup."
  echo "For this to be successful this directory should be empty and any previous containers/volumes removed."
  echo
  # If the directory exists but was incomplete, remove it so onelinesetup can recreate cleanly.
  if [[ -d "${MAGENTO_DIR}" ]]; then
    echo "Removing existing directory '${MAGENTO_DIR}' so it can be recreated..."
    rm -rf "${MAGENTO_DIR}"
  fi
  mkdir -vp "${MAGENTO_DIR}"
  cd "${MAGENTO_DIR}"

  # The onelinesetup steps, run one at a time so the port and download checks fit between them.
  echo "Running Magento onelinesetup for host '${MAGENTO_HOST}' and version '${MAGENTO_VERSION}'..."
  curl -fsS "${DOCKER_MAGENTO_LIB}/template" | bash
  # docker-magento publishes phpMyAdmin on 8080, which other local services often hold.
  sed -i.bak "s/\"8080:80\"/\"${PHPMYADMIN_PORT}:80\"/" compose.dev.yaml compose.dev-linux.yaml
  rm -f compose.dev.yaml.bak compose.dev-linux.yaml.bak
  # Mount the host CA dir as mkcert's CAROOT. setup-ssl makes the CA there once, then every install reuses it.
  mkdir -p "${DEV_CA_DIR}" && chmod 700 "${DEV_CA_DIR}"
  awk -v m="${DEV_CA_DIR}:${CONTAINER_CA_DIR}" \
    '{ print } /^ *- ssldata:\/etc\/nginx\/certs$/ { ind = $0; sub(/-.*/, "", ind); print ind "- " m }' \
    compose.yaml > compose.yaml.tmp && mv compose.yaml.tmp compose.yaml
  grep -qF "${CONTAINER_CA_DIR}" compose.yaml || echo "Warning: could not add the CA mount; each install will create a new CA."
  # Pin images before the first boot, as bin/download does, so the stack does not pull the defaults first.
  bin/detect-versions community "${MAGENTO_VERSION}" || true
  __start_with_retry --no-dev
  # docker-magento's bin/setup-composer-auth does not read env vars or prompted keys. Save them to the mounted ~/.composer.
  if [[ -n "${ADOBE_ACCESS_PUBLIC_KEY:-}" && -n "${ADOBE_ACCESS_PRIVATE_KEY:-}" ]]; then
    echo "composer config --global http-basic.repo.magento.com ${ADOBE_ACCESS_PUBLIC_KEY} ${ADOBE_ACCESS_PRIVATE_KEY}" \
      | bin/clinotty bash -
  fi
  bin/download community "${MAGENTO_VERSION}"
  # bin/download exits 0 even when it fails. Its files are in the container until bin/setup copies them out.
  if ! bin/clinotty test -f bin/magento; then
    echo "Magento download failed: bin/magento is missing in the phpfpm container."
    echo "Likely causes: invalid Adobe access keys (HTTP 401), or a service that did not start."
    echo "Read the output above, then run 'mise run dev:reset' and install again."
    exit 1
  fi
  bin/setup "${MAGENTO_HOST}"
  echo "Initial Magento onelinesetup completed."

  # Clean up inner git repo and ensure we ignore the install directory in this project
  rm -rf "${MAGENTO_DIR}/.git"
  __ensure_line_in_file "${ROOT_DIR}/.gitignore" "${MAGENTO_DIR##*/}/"
else
  echo "Existing Magento install detected at '${MAGENTO_DIR}', skipping onelinesetup."
  cd "${MAGENTO_DIR}"
fi

if [[ ! -x "${MAGENTO_DIR}/bin/start" ]]; then
  echo "Expected '${MAGENTO_DIR}/bin/start' to exist and be executable, but it was not found."
  echo "Ensure the Magento installation in '${MAGENTO_DIR}' completed successfully."
  exit 1
fi

echo "Starting IT Magento stack in '${MAGENTO_DIR}'..."
__start_with_retry

echo "IT Magento stack is starting. Use '${MAGENTO_DIR}/bin/cli' for Magento CLI commands."
