#!/usr/bin/env bash
set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
# shellcheck source=lib/clean-path
source "${DIR}/lib/clean-path"
ROOT_DIR="$( cd "${DIR}/.." >/dev/null 2>&1 && pwd )"
MAGENTO_DIR="${1:-$ROOT_DIR/magento-install}"

# Ensure Magento dev install exists
if [[ ! -d "${MAGENTO_DIR}" || ! -x "${MAGENTO_DIR}/bin/cli" ]]; then
  echo "Magento dev installation not found in '${MAGENTO_DIR}'."
  echo "Run 'mise run dev:up' and 'mise run dev:install' first to create and configure the stack."
  exit 1
fi

echo "Deploying Magento sample data (dev) using Magento install at '${MAGENTO_DIR}'..."
cd "${MAGENTO_DIR}"

./bin/cli bin/magento sampledata:deploy
./bin/cli bin/magento setup:upgrade
./bin/cli bin/magento indexer:reindex
./bin/cli bin/magento cache:flush

echo "Sample data deployed."
