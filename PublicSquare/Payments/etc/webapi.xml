<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Checkout asks whether the selected saved card needs its CVV re-entered. -->
    <route url="/V1/publicsquare/carts/mine/cvv-requirement" method="POST">
        <service class="PublicSquare\Payments\Api\CvvRequirementInterface" method="check"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
</routes>
